package sloth

import (
	"fmt"
	"iter"
	"sync"
)

type Node struct {
	Id     int64
	Weight int64
}

type Nodes struct {
	Nodes []*Node
	Total int
	Index int
}

type SMap struct {
	m   map[string]*Nodes
	mu  sync.RWMutex
	idx int64
}

func NewSMap() *SMap {
	return &SMap{
		m:   map[string]*Nodes{},
		mu:  sync.RWMutex{},
		idx: 0,
	}
}

// 提供给 for range 遍历 map所有 key
//
//	for k,v := range smap.Range(){
//
//	}
func (s *SMap) Range() iter.Seq2[string, *Nodes] {
	return func(yield func(string, *Nodes) bool) {
		s.mu.RLock()
		defer s.mu.RUnlock()
		for k, v := range s.m {
			if !yield(k, v) {
				return
			}
		}
	}
}

func (s *SMap) Len() int {
	s.mu.RLock()
	defer s.mu.RUnlock()
	return len(s.m)
}

func (s *SMap) Get(key string, m int) (*Node, bool) {
	s.mu.RLock()
	defer s.mu.RUnlock()
	v, ok := s.m[key]
	if !ok {
		return nil, false
	}
	node, err := chooseNode(v, m)
	if err != nil {
		return nil, false
	}
	return node, true
}

// 根据 权重选择一个节点
// m = 1 轮询选择一个节点
// m = 2 随机选择一个节点

func chooseNode(nodes *Nodes, m int) (*Node, error) {
	l := len(nodes.Nodes)
	if l == 0 {
		return nil, nil
	}
	if m == 1 {
		nodes.Index++
		if nodes.Index >= l {
			nodes.Index = 0
		}
		return nodes.Nodes[nodes.Index], nil
	}
	return nil, fmt.Errorf("m %d not support", m)
}

func (s *SMap) Del(key string) error {
	s.mu.RLock()
	defer s.mu.RUnlock()
	_, ok := s.m[key]
	if ok {
		delete(s.m, key)
	}
	return nil
}

func (s *SMap) Reg(key string, check bool) (*Node, error) {
	s.mu.Lock()
	defer s.mu.Unlock()
	n, ok := s.m[key]
	if ok {
		if check {
			return nil, fmt.Errorf("key %s already registered", key)
		}
		return chooseNode(n, 1)
	}
	s.idx--
	n.Nodes = append(s.m[key].Nodes, &Node{
		Id: s.idx,
	})
	return chooseNode(n, 1)
}
